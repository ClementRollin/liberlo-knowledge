# Base de données PostgreSQL
# - En local (sans Docker) : hôte = localhost
# - En Docker              : hôte = db (géré automatiquement par docker-compose)
DATABASE_URL="postgresql://liberlo:liberlo_dev@localhost:5432/liberlo_kb?schema=public"

# JWT
JWT_SECRET="changeme_in_production_use_strong_random_secret"
JWT_EXPIRES_IN="8h"

# OpenAI (embeddings pour la recherche sémantique)
OPENAI_API_KEY="sk-proj-..."

# Anthropic (analyse documentaire via Claude Haiku)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Drive OAuth2 (import de documents)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/import/drive/callback"

# Application
PORT=3001
FRONTEND_URL="http://localhost:5173"
