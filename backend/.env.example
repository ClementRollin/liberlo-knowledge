# Base de données PostgreSQL
# - En local (sans Docker) : hôte = localhost
# - En Docker              : hôte = db (géré automatiquement par docker-compose)
DATABASE_URL="postgresql://liberlo:liberlo_dev@localhost:5432/liberlo_kb?schema=public"

# JWT
JWT_SECRET="changeme_in_production_use_strong_random_secret"
JWT_EXPIRES_IN="8h"

# OpenAI — clé API pour les embeddings (text-embedding-3-small) et la recherche sémantique
# Obligatoire pour que la recherche sémantique fonctionne
OPENAI_API_KEY="sk-proj-..."

# Anthropic — analyse documentaire via Claude Haiku (module Import)
# Obligatoire uniquement si le module d'import est utilisé
ANTHROPIC_API_KEY="sk-ant-..."

# Google Drive OAuth2 (import de documents Google Drive)
# Optionnel — laisser vide si l'import Drive n'est pas utilisé pour la démo
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/import/drive/callback"

# Application
PORT=3001
FRONTEND_URL="http://localhost:5173"
